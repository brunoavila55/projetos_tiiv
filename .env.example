# Segredos: gere cada um com `openssl rand -hex 24` (mínimo 12 caracteres).
# O app se recusa a subir com senhas padrão, curtas ou com o superusuário postgres.

# Conexão com o banco (só para rodar o backend fora do Docker; o `make dev`/`make test`
# monta a mesma URL a partir de APP_DB_USER/APP_DB_PASSWORD, e o compose também)
# DATABASE_URL=postgres://tiiv_app:<APP_DB_PASSWORD>@localhost:5432/tiiv?sslmode=disable

# Endereço de escuta do servidor HTTP
LISTEN_ADDR=:8080

# Tempo de expiração da sessão por inatividade (ex: 30m, 1h)
SESSION_TTL=30m

# Tempo máximo absoluto de expiração da sessão (ex: 12h, 24h)
SESSION_MAX_TTL=12h

# Cookie só por HTTPS. Deixe true quando houver TLS na frente (ver README, "HTTPS");
# isso também liga o HSTS. false apenas em rede local só com HTTP.
COOKIE_SECURE=false

# Primeiro administrador (só quando o banco está vazio). Deixe ADMIN_PIN vazio para
# sortear um PIN, mostrado uma única vez no log. PINs triviais (1234, 0000, 1111,
# sequências) são recusados, e o admin precisa trocar o PIN no primeiro acesso.
ADMIN_NOME=Administrador
ADMIN_PIN=

# Falhas de PIN aceitas por terminal (IP) em 15 minutos; abaixo de 5 para que um
# único terminal não consiga bloquear a conta de ninguém
LOGIN_FALHAS_POR_IP=4

# Tira-dúvidas da tela de acesso (Cloudflare Workers AI). Vazio = desligado.
# Token criado com o modelo "Workers AI" (My Profile → API Tokens); o ID da conta aparece no painel da Cloudflare.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Limite diário de neurons (a cota grátis é 10.000/dia, renovada à 00:00 UTC)
ASSISTENTE_NEURONS_DIA=9500

# Fuso horário
TZ=America/Sao_Paulo

# Configurações do container Postgres no Compose
# Superusuário: só para administração e backup; o app usa APP_DB_USER
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=tiiv

# Papel do app, sem superusuário (criado por scripts/initdb/10-papel-app.sh)
APP_DB_USER=tiiv_app
APP_DB_PASSWORD=troque-por-uma-senha-forte
