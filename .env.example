# Conexão com o banco de dados PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tiiv?sslmode=disable

# Endereço de escuta do servidor HTTP
LISTEN_ADDR=:8080

# Tempo de expiração da sessão por inatividade (ex: 30m, 1h)
SESSION_TTL=30m

# Tempo máximo absoluto de expiração da sessão (ex: 12h, 24h)
SESSION_MAX_TTL=12h

# Flag para cookie seguro (definir como false para rede local HTTP, true para HTTPS)
COOKIE_SECURE=false

# Credenciais para criação automática do primeiro administrador (se o banco estiver vazio)
ADMIN_NOME=Administrador
ADMIN_PIN=1234

# Tira-dúvidas da tela de acesso (Cloudflare Workers AI). Vazio = desligado.
# Token criado com o modelo "Workers AI" (My Profile → API Tokens); o ID da conta aparece no painel da Cloudflare.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
# Limite diário de neurons (a cota grátis é 10.000/dia, renovada à 00:00 UTC)
ASSISTENTE_NEURONS_DIA=9500

# Fuso horário
TZ=America/Sao_Paulo

# Configurações do container Postgres no Compose
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tiiv
